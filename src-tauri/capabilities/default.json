{
	"$schema": "../gen/schemas/desktop-schema.json",
	"identifier": "default",
	"description": "Berechtigungen des Hauptfensters",
	"windows": ["main"],
	"permissions": [
		"core:default",
		"dialog:allow-open",
		"dialog:allow-save",
		"fs:allow-appdata-read-recursive",
		"fs:allow-appdata-write-recursive",
		"fs:allow-appdata-meta-recursive",
		{
			"identifier": "http:default",
			"allow": [
				{ "url": "https://services.dlrg.net/*" },
				{ "url": "https://raw.githubusercontent.com/dennisfabri/JAuswertung/*" }
			]
		},
		{
			"identifier": "opener:allow-open-url",
			"allow": [
				{ "url": "https://github.com/joe2824/*" },
				{ "url": "https://github.com/dennisfabri/JAuswertung" },
				{ "url": "https://fonts.google.com/specimen/Nunito" },
				{ "url": "https://openfontlicense.org/" },
				{ "url": "https://www.naturalearthdata.com/" },
				{ "url": "https://shadcn-svelte.com/" }
			]
		},
		"updater:default",
		"process:allow-restart"
	]
}
