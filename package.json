    "@tauri-apps/plugin-fs": "2.7.1",
    "@tauri-apps/plugin-http": "2.8.3",
    "@tauri-apps/plugin-opener": "2.7.2",
    "@tauri-apps/plugin-process": "2.4.0",
    "@tauri-apps/plugin-updater": "2.14.0",
    "bits-ui": "2.19.5",
    "clsx": "2.1.1",
    "fflate": "0.8.3",
    "geographiclib-geodesic": "2.2.0",
    "papaparse": "5.7.0",
    "svelte-dnd-action": "0.9.80",
    "tailwind-merge": "3.7.0",
    "tailwind-variants": "3.3.1"
