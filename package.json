    "@types/papaparse": "5.5.2",
    "@vitest/coverage-v8": "4.1.11",
    "happy-dom": "21.0.1",
    "mode-watcher": "1.1.0",
    "prettier": "3.9.9",
    "prettier-plugin-svelte": "4.1.1",
    "svelte": "5.57.2",
    "svelte-check": "4.7.6",
    "svelte-sonner": "1.2.1",
    "tailwindcss": "4.3.3",
